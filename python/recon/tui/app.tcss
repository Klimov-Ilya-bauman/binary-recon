/* ========================================================================== */
/*                       BINARY RECON — TUI STYLES                            */
/* ========================================================================== */

Screen {
    background: $surface;
}

/* Утилита: скрытые элементы. */
.hidden {
    display: none;
}

/* ========================================================================== */
/*                          WELCOME SCREEN                                    */
/* ========================================================================== */

#welcome-root {
    align: center middle;
    width: 100%;
    height: 100%;
}

#logo {
    color: $accent;
    text-style: bold;
    content-align: center middle;
    width: 100%;
    margin-top: 1;
}

#tagline {
    color: $text-muted;
    content-align: center middle;
    width: 100%;
    margin-bottom: 2;
}

#menu {
    width: 32;
    height: auto;
}

#menu Button {
    width: 100%;
    margin-bottom: 1;
}

/* ========================================================================== */
/*                          HELP SCREEN                                       */
/* ========================================================================== */

#help-scroll {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#help-content {
    width: 100%;
    max-width: 90;
    margin: 0 4;
}

#help-text {
    width: 100%;
}

/* ========================================================================== */
/*                          TODO PLACEHOLDER                                  */
/* ========================================================================== */

#todo-box {
    width: 60;
    height: auto;
    border: round $accent;
    padding: 2 3;
    align: center middle;
}

.todo-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.todo-message {
    color: $text;
    width: 100%;
}

.todo-spacer {
    height: 1;
}

.todo-hint {
    color: $text-muted;
    text-style: italic;
}

/* ========================================================================== */
/*                          ANALYZE SCREEN                                    */
/* ========================================================================== */

#analyze-root {
    padding: 1 4;
    height: 100%;
}

#analyze-intro {
    margin-bottom: 1;
    color: $text;
}

#path-input {
    margin-bottom: 1;
}

#analyze-actions {
    width: 40;
    height: auto;
    margin-bottom: 1;
}

#analyze-actions Button {
    width: 100%;
    margin-bottom: 1;
}

#progress-box {
    width: 100%;
    height: auto;
    padding: 1 0;
    border: round $primary;
    margin-bottom: 1;
}

#progress-label {
    margin-bottom: 1;
    content-align: center middle;
}

#progress-bar {
    width: 100%;
}

#status-line {
    width: 100%;
    margin-top: 1;
    content-align: center middle;
}

/* ========================================================================== */
/*                          RESULTS SCREEN                                    */
/* ========================================================================== */

#results-header {
    width: 100%;
    height: auto;
    padding: 1 2;
    border-bottom: heavy $primary;
}

#header-file {
    color: $text;
    margin-bottom: 0;
}

#header-meta {
    color: $text;
    margin-bottom: 0;
}

#header-summary {
    color: $text-muted;
    margin-bottom: 1;
}

#risk-bar {
    width: 100%;
}

#results-tabs {
    height: 1fr;       /* занимает всё доступное место */
}

TabPane {
    padding: 1 2;
}

#overview-text {
    width: 100%;
    padding: 1 2;
}

#sections-table,
#imports-table,
#findings-table,
#strings-table {
    height: 1fr;
}

#strings-pane {
    height: 100%;
}

#string-filter {
    margin-bottom: 1;
}

/* ========================================================================== */
/*                          HISTORY SCREEN                                    */
/* ========================================================================== */

#history-root {
    padding: 1 2;
    height: 100%;
}

#history-summary {
    width: 100%;
    margin-bottom: 1;
    color: $text;
}

#history-controls {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#history-search {
    width: 100%;
}

#history-filters {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    align-horizontal: left;
}

.filter-btn {
    width: 12;
    margin-right: 1;
}

#history-table {
    height: 1fr;
}

/* ========================================================================== */
/*                          EXPORT MODAL                                      */
/* ========================================================================== */

ExportModalScreen {
    align: center middle;
    background: $surface 80%;
}

#export-modal {
    width: 60;
    height: auto;
    background: $surface;
    border: thick $accent;
    padding: 1 2;
}

#export-buttons {
    width: 40;
    height: auto;
}

#export-buttons Button {
    width: 100%;
    margin-bottom: 1;
}

#exp-path { margin-bottom: 1; }
#exp-status { content-align: center middle; }

/* BATCH SCREEN */
#batch-root { padding: 1 2; height: 100%; }
#batch-path { margin-bottom: 1; }
#batch-start { width: 20; margin-bottom: 1; }
#batch-progress { margin-bottom: 1; }
#batch-status { margin-bottom: 1; }
#batch-table { height: 1fr; }
