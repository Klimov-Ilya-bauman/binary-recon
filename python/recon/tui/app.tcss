/* ========================================================================== */
/*                       BINARY RECON — TUI STYLES                            */
/* ========================================================================== */

/* Глобальные настройки. Screen — это все экраны приложения. */
Screen {
    background: $surface;
}

/* ========================================================================== */
/*                          WELCOME SCREEN                                    */
/* ========================================================================== */

#welcome-root {
    align: center middle;       /* центрируем содержимое по горизонтали и вертикали */
    width: 100%;
    height: 100%;
}

#logo {
    color: $accent;             /* цветовая переменная из темы Textual */
    text-style: bold;
    content-align: center middle;
    width: 100%;
    margin-top: 1;
}

#tagline {
    color: $text-muted;
    content-align: center middle;
    width: 100%;
    margin-bottom: 2;
}

/* Меню кнопок: вертикально, фиксированной ширины, плотно. */
#menu {
    width: 32;
    height: auto;
}

#menu Button {
    width: 100%;
    margin-bottom: 1;
}

/* ========================================================================== */
/*                          HELP SCREEN                                       */
/* ========================================================================== */

#help-scroll {
    width: 100%;
    height: 100%;
    padding: 1 2;
}

#help-content {
    width: 100%;
    max-width: 90;             /* не растягивать на широких терминалах */
    margin: 0 4;
}

#help-text {
    width: 100%;
}

/* ========================================================================== */
/*                          TODO PLACEHOLDER SCREEN                           */
/* ========================================================================== */

#todo-box {
    width: 60;
    height: auto;
    border: round $accent;
    padding: 2 3;
    align: center middle;
}

.todo-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.todo-message {
    color: $text;
    width: 100%;
}

.todo-spacer {
    height: 1;
}

.todo-hint {
    color: $text-muted;
    text-style: italic;
}
